{
  "name": "@dwtechs/servpico-express",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Open source library to start and close Express.js service properly.",
  "keywords": [
    "serve",
    "Express"
  ],
  "homepage": "https://github.com/DWTechs/Servpico-express.js",
  "main": "dist/servpico-express.js",
  "types": "dist/servpico-express.d.ts",
  "exports": {
    ".": {
      "types": "./dist/servpico-express.d.ts",
      "import": "./dist/servpico-express.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DWTechs/Servpico-express.js"
  },
  "bugs": {
    "url": "https://github.com/DWTechs/Servpico-express.js/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Ludovic Cluber",
    "email": "http://www.lcluber.com/contact",
    "url": "http://www.lcluber.com"
  },
  "scripts": {
    "prebuild": "npm install",
    "build": "node ./scripts/clear && tsc && npm run rollup && node ./scripts/copy && npm run test",
    "rollup:mjs": "rollup --config rollup.config.mjs",
    "rollup": "npm run rollup:mjs",
    "test": "jest --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dwtechs/winstan": "0.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@types/express": "5.0.6",
    "@types/node": "25.6.2",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "rollup": "4.24.0",
    "typescript": "6.0.3"
  }
}
